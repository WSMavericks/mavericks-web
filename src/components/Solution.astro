---
// Solution.astro — Portfolio de Sistemas (sección estática debajo del 3D scrollytelling)
// Las 4 feature cards han sido integradas en los overlays de QuantChart3D.
// Esta sección sirve como "auditoría en frío" de los datos reales.

const portfolio = [
  { name:'WSM-TREND-01',    market:'NQ / ES',   sharpe:'2.34', dd:'−7.1%',  status:'live'    },
  { name:'WSM-FLOW-03',     market:'EUR/USD',   sharpe:'1.92', dd:'−9.8%',  status:'live'    },
  { name:'WSM-BREAKOUT-07', market:'GC / CL',   sharpe:'2.11', dd:'−6.3%',  status:'live'    },
  { name:'WSM-ML-12',       market:'BTC / ETH', sharpe:'1.88', dd:'−11.2%', status:'testing' },
];

const metrics = [
  { label:'Sistemas Live',  val:'3'     },
  { label:'Sharpe Pond.',   val:'2.12'  },
  { label:'DD Máx',         val:'−11.2%'},
  { label:'Win Rate',       val:'61.8%' },
];

const checklist = [
  'Walk-forward analysis en datos OOS exclusivos',
  'Monte Carlo con 5.000+ iteraciones por sistema',
  'Sharpe mínimo requerido: 1.8 antes de cualquier live',
  'Drawdown máximo permitido: −15%',
  'Prueba de robustez multi-activo y multi-timeframe',
];
---

<section
  aria-label="Portfolio de sistemas cuantitativos en producción"
  style="position:relative;background:#080808;padding:8rem 0;border-top:1px solid rgba(0,255,102,0.07);overflow:hidden;"
>

  <!-- Decorative numeral watermark -->
  <div aria-hidden="true" style="position:absolute;right:-1rem;top:50%;transform:translateY(-50%);font-family:'Inter',sans-serif;font-weight:900;font-size:20vw;color:rgba(0,255,102,0.018);letter-spacing:-0.1em;user-select:none;pointer-events:none;line-height:1;">03</div>

  <div style="max-width:1400px;margin:0 auto;padding:0 2rem;position:relative;z-index:10;">

    <!-- ── Section header ── -->
    <div class="reveal" style="margin-bottom:5rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
        <span style="width:2rem;height:1px;background:#00FF66;display:inline-block;"></span>
        <span style="font-family:'Inter',sans-serif;font-size:0.6375rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:#00FF66;">Evidencia real. Sin filtros.</span>
      </div>
      <div style="display:grid;grid-template-columns:61.8fr 38.2fr;gap:4rem;align-items:end;" class="portfolio-header-grid">
        <h2 style="font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(2rem,4.5vw,3.25rem);letter-spacing:-0.05em;color:#fff;line-height:1.05;margin:0;">
          Audita los números.<br/>
          <span class="quant-hook" style="font-size:clamp(2.2rem,5vw,3.5rem);">En frío.</span>
        </h2>
        <p style="font-family:'Inter',sans-serif;font-size:0.9rem;line-height:1.75;color:#6B7280;margin:0;">
          Los sistemas que sobrevivieron la superficie de optimización son los únicos que operamos.
          Aquí están los números reales de producción, sin curva de capital maquillada.
        </p>
      </div>
    </div>

    <!-- ── Two-column layout: checklist + portfolio ── -->
    <div style="display:grid;grid-template-columns:38.2fr 61.8fr;gap:4rem;align-items:stretch;" class="portfolio-main-grid">

      <!-- Left: checklist + CTA -->
      <div class="reveal" style="display:flex;flex-direction:column;justify-content:center;gap:2rem;">
        <h3 style="font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(1.5rem,3vw,2.125rem);letter-spacing:-0.04em;color:#fff;line-height:1.1;margin:0;">
          Solo operamos<br/>lo que sobrevive<br/>
          <span class="quant-hook">la simulación.</span>
        </h3>

        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
          {checklist.map((item) => (
            <li style="display:flex;align-items:flex-start;gap:0.875rem;">
              <span style="width:6px;height:6px;background:#00FF66;border-radius:2px;flex-shrink:0;margin-top:0.46rem;"></span>
              <span style="font-family:'Inter',sans-serif;font-size:0.875rem;color:#D1D5DB;line-height:1.65;">{item}</span>
            </li>
          ))}
        </ul>

        <a
          href="#laboratorio"
          id="solution-cta"
          class="btn-quant"
          style="align-self:flex-start;"
        >
          Acceder al Laboratorio
        </a>
      </div>

      <!-- Right: portfolio dashboard -->
      <div class="reveal reveal-delay-2">
        <div
          id="portfolio-dashboard"
          style="background:#080808;border:1px solid rgba(0,255,102,0.15);border-radius:16px;padding:2rem;transition:border-color 0.3s ease;"
          onmouseover="this.style.borderColor='rgba(0,255,102,0.3)'"
          onmouseout="this.style.borderColor='rgba(0,255,102,0.15)'"
        >
          <!-- Dashboard header -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,0.05);">
            <span style="font-family:'Inter',sans-serif;font-size:0.68rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:#4B5563;">
              Portfolio de Sistemas — Q2 2026
            </span>
            <span style="font-family:'Inter',sans-serif;font-size:0.65rem;color:#00FF66;letter-spacing:0.08em;display:flex;align-items:center;gap:0.4rem;">
              <span style="width:6px;height:6px;background:#00FF66;border-radius:50%;display:inline-block;animation:pulse-green 2s ease-in-out infinite;"></span>
              ACTIVO
            </span>
          </div>

          <!-- Column headers -->
          <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:1rem;padding:0 0 0.625rem;border-bottom:1px solid rgba(255,255,255,0.04);margin-bottom:0.25rem;">
            {['Sistema','Mercado','Sharpe','DD Máx','Estado'].map((h) => (
              <span style="font-family:'Inter',sans-serif;font-size:0.58rem;color:#374151;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;">{h}</span>
            ))}
          </div>

          <!-- Portfolio rows -->
          {portfolio.map((sys) => (
            <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:1rem;align-items:center;padding:0.875rem 0;border-bottom:1px solid rgba(255,255,255,0.04);font-family:'Inter',sans-serif;font-size:0.75rem;">
              <span style="color:#D1D5DB;font-weight:600;font-family:'Courier New',monospace;font-size:0.72rem;letter-spacing:0.04em;">{sys.name}</span>
              <span style="color:#6B7280;">{sys.market}</span>
              <span style="color:#00FF66;font-weight:700;">SR {sys.sharpe}</span>
              <span style="color:#D1D5DB;">{sys.dd}</span>
              <span style={`font-size:0.58rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:0.22rem 0.65rem;border:1px solid ${sys.status === 'live' ? 'rgba(0,255,102,0.4)' : 'rgba(255,153,68,0.4)'};border-radius:4px;color:${sys.status === 'live' ? '#00FF66' : '#FF9944'};`}>
                {sys.status === 'live' ? 'Live' : 'Test'}
              </span>
            </div>
          ))}

          <!-- Aggregate metrics -->
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid rgba(0,255,102,0.1);">
            {metrics.map((m) => (
              <div>
                <div style="font-size:0.58rem;color:#4B5563;letter-spacing:0.1em;text-transform:uppercase;font-family:'Inter',sans-serif;">{m.label}</div>
                <div style="font-size:1.05rem;font-weight:700;color:#fff;font-family:'Inter',sans-serif;margin-top:0.3rem;letter-spacing:-0.03em;">{m.val}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes pulse-green { 0%,100%{opacity:.35} 50%{opacity:1} }

  @media (max-width: 1024px) {
    .portfolio-header-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
    .portfolio-main-grid   { grid-template-columns: 1fr !important; gap: 2.5rem !important; }
  }
</style>
