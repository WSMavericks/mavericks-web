---
// LeadCapture.astro — Section 5: El Laboratorio / Captura de Leads
// Updated copy from landing_content.md §5, rounded inputs + form, smooth transitions
import SvgTextures from './SvgTextures.astro';
---

<section id="laboratorio" aria-labelledby="laboratorio-heading"
  style="position:relative;background:#080808;padding:8rem 0;overflow:hidden;border-top:1px solid rgba(0,255,102,0.07);">

  <SvgTextures variant="grid" />

  <!-- Ambient glow -->
  <div aria-hidden="true" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:60vw;height:60vw;background:radial-gradient(ellipse,rgba(0,255,102,0.04) 0%,transparent 65%);pointer-events:none;"></div>

  <div style="max-width:1400px;margin:0 auto;padding:0 2rem;position:relative;z-index:10;">
    <div class="lead-grid" style="display:grid;grid-template-columns:61.8fr 38.2fr;gap:6rem;align-items:start;">

      <!-- LEFT: copy + form -->
      <div>
        <!-- Eyebrow -->
        <div class="reveal" style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;">
          <span style="display:inline-block;width:2rem;height:1px;background:#00FF66;"></span>
          <span style="font-family:'Inter',sans-serif;font-size:0.6375rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:#00FF66;">05 — El Laboratorio</span>
        </div>

        <!-- H2 -->
        <h2 id="laboratorio-heading" class="reveal reveal-delay-1"
          style="font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(2.25rem,5vw,3.75rem);letter-spacing:-0.05em;color:#fff;line-height:1.0;margin:0 0 1.75rem;">
          Accede a las<br />
          <span class="quant-hook" style="font-size:clamp(2.5rem,5.5vw,4rem);">trincheras estadísticas.</span>
        </h2>

        <!-- Description — literal from landing_content.md §5 -->
        <p class="reveal reveal-delay-2" style="font-family:'Inter',sans-serif;font-size:1rem;line-height:1.82;color:#D1D5DB;max-width:52ch;margin:0 0 2.5rem;">
          Únete al <span class="quant-hook" style="font-size:1rem;">Quant Lab</span> de Mavericks.
          Documentamos nuestros resultados, configuraciones de hardware y procesos de optimización.
          Recibe desgloses técnicos, análisis de mercado desde una perspectiva de datos pura y
          prioridad para la próxima ronda de Copytrading.
        </p>

        <!-- Benefits list -->
        <ul class="reveal reveal-delay-2" style="list-style:none;padding:0;margin:0 0 3rem;display:flex;flex-direction:column;gap:0.875rem;">
          {[
            'Desgloses técnicos semanales de nuestros sistemas',
            'Métricas en vivo: Sharpe, DD, Win Rate por algoritmo',
            'Configuraciones de hardware e infraestructura',
            'Acceso prioritario a la ronda de Copytrading',
            'Reportes Monte Carlo de nuevas estrategias',
          ].map((item) => (
            <li style="display:flex;align-items:flex-start;gap:0.875rem;">
              <span style="width:16px;height:16px;border:1px solid rgba(0,255,102,0.4);border-radius:4px;flex-shrink:0;margin-top:0.1rem;display:flex;align-items:center;justify-content:center;transition:background 0.2s ease,border-color 0.2s ease;">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true"><path d="M1 4l2 2 4-4" stroke="#00FF66" stroke-width="1.5"/></svg>
              </span>
              <span style="font-family:'Inter',sans-serif;font-size:0.875rem;color:#D1D5DB;line-height:1.65;">{item}</span>
            </li>
          ))}
        </ul>

        <!-- ── EMAIL FORM ── -->
        <div class="reveal reveal-delay-3">
          <form id="lead-form" name="lead-capture" method="POST" novalidate
            style="display:flex;flex-direction:column;gap:1rem;max-width:460px;"
            aria-label="Formulario de acceso al laboratorio">

            <div>
              <label for="email-input"
                style="display:block;font-family:'Inter',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#4B5563;margin-bottom:0.5rem;">
                Tu correo electrónico profesional
              </label>
              <input
                id="email-input"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="trader@ejemplo.com"
                style="width:100%;background:#0A0A0A;border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:#fff;font-family:'Inter',sans-serif;font-size:0.9375rem;padding:0.9375rem 1.25rem;outline:none;transition:border-color 0.25s ease,box-shadow 0.25s ease;"
                onfocus="this.style.borderColor='rgba(0,255,102,0.5)';this.style.boxShadow='0 0 0 3px rgba(0,255,102,0.07)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)';this.style.boxShadow='none'"
              />
            </div>

            <button id="form-submit" type="submit" class="btn-quant"
              style="width:100%;text-align:center;padding:1rem 1.75rem;font-size:0.8125rem;">
              Solicitar Acceso al Laboratorio
            </button>

            <p style="font-family:'Inter',sans-serif;font-size:0.7rem;color:#374151;line-height:1.6;margin:0;">
              Cero spam. Solo código, infraestructura y métricas. —
              <a href="#" style="color:#4B5563;text-decoration:underline;text-underline-offset:3px;transition:color 0.2s;" onmouseover="this.style.color='#00FF66'" onmouseout="this.style.color='#4B5563'">Política de privacidad</a>.
            </p>
          </form>

          <!-- Success state -->
          <div id="form-success" role="alert" aria-live="polite"
            style="display:none;margin-top:1.5rem;padding:1.25rem 1.5rem;border:1px solid rgba(0,255,102,0.3);border-radius:12px;background:rgba(0,255,102,0.04);">
            <p style="font-family:'Inter',sans-serif;font-size:0.875rem;color:#00FF66;font-weight:600;margin:0;">✓ Acceso solicitado correctamente.</p>
            <p style="font-family:'Inter',sans-serif;font-size:0.8rem;color:#6B7280;margin:0.4rem 0 0;">Revisaremos tu solicitud y te contactaremos en 24–48h.</p>
          </div>
        </div>

        <!--
        ═══════════════════════════════════════════════
         CALENDLY PLACEHOLDER — descomentar para activar
        ═══════════════════════════════════════════════
        <div style="margin-top:3rem;border:1px solid rgba(0,255,102,0.15);border-radius:16px;overflow:hidden;">
          <iframe
            src="https://calendly.com/YOUR_CALENDLY_URL"
            width="100%" height="700" frameborder="0"
            title="Agendar reunión con Wall Street Mavericks"
            loading="lazy" style="display:block;">
          </iframe>
        </div>
        -->
      </div>

      <!-- RIGHT: process + trust -->
      <div class="reveal reveal-delay-3" style="display:flex;flex-direction:column;gap:1.5rem;padding-top:5rem;">
        <!-- Process steps -->
        <div style="background:#0A0A0A;border:1px solid rgba(0,255,102,0.12);border-radius:16px;padding:2rem;transition:border-color 0.3s ease;"
          onmouseover="this.style.borderColor='rgba(0,255,102,0.3)'" onmouseout="this.style.borderColor='rgba(0,255,102,0.12)'">
          <div style="font-family:'Inter',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#4B5563;margin-bottom:1.5rem;">Cómo funciona</div>
          {[
            { step:'01', text:'Envías tu correo y solicitas acceso.' },
            { step:'02', text:'Verificamos el perfil y aprobamos en 48h.' },
            { step:'03', text:'Accedes al feed semanal del Quant Lab.' },
            { step:'04', text:'Prioridad en la siguiente ronda de Copytrading.' },
          ].map((s, i) => (
            <div style={`display:flex;gap:1rem;padding:0.875rem 0;${i<3?'border-bottom:1px solid rgba(255,255,255,0.04);':''}`}>
              <span style="font-family:'Inter',sans-serif;font-weight:900;font-size:0.62rem;letter-spacing:0.15em;color:rgba(0,255,102,0.4);flex-shrink:0;padding-top:0.1rem;">{s.step}</span>
              <span style="font-family:'Inter',sans-serif;font-size:0.8rem;color:#D1D5DB;line-height:1.6;">{s.text}</span>
            </div>
          ))}
        </div>

        <!-- Trust signal -->
        <div style="padding:1.25rem 1.5rem;border:1px solid rgba(255,255,255,0.06);border-radius:12px;display:flex;gap:1rem;align-items:flex-start;transition:border-color 0.3s ease;"
          onmouseover="this.style.borderColor='rgba(0,255,102,0.2)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(0,255,102,0.5)" stroke-width="1.5" style="flex-shrink:0;margin-top:.1rem;" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <p style="font-family:'Inter',sans-serif;font-size:0.75rem;color:#4B5563;line-height:1.65;margin:0;">Sin spam. Sin calls de ventas. Solo contenido de alto valor técnico. Puedes darte de baja en cualquier momento.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width:900px) {
    .lead-grid > div:last-child { padding-top:0 !important; }
    .lead-grid { grid-template-columns:1fr !important; gap:3rem !important; }
  }
  input::placeholder { color:#374151; }
</style>

<script>
  const form       = document.getElementById('lead-form');
  const successMsg = document.getElementById('form-success');
  const submitBtn  = document.getElementById('form-submit');

  if (form && successMsg && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('#email-input');
      if (!emailInput || !(emailInput instanceof HTMLInputElement)) return;
      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim());
      if (!emailValid) {
        emailInput.style.borderColor = 'rgba(255,68,68,0.6)';
        emailInput.focus();
        return;
      }
      submitBtn.setAttribute('disabled','true');
      submitBtn.textContent = 'Procesando...';
      setTimeout(() => {
        form.style.display = 'none';
        successMsg.style.display = 'block';
      }, 900);
    });
  }
</script>
