---
// Brain.astro — NEW Section 4: El Cerebro Digital (Knowledge & Research)
// Content from landing_content.md §4
import SvgTextures from './SvgTextures.astro';

const nodes = [
  { label:'Backtests Documentados',  val:'2.400+', desc:'Fallos y éxitos archivados como aprendizaje estructurado' },
  { label:'Grafo Semántico',         val:'Activo',  desc:'Repositorio interconectado de investigación financiera' },
  { label:'Evolución Continua',      val:'24/7',    desc:'El sistema de conocimiento crece con cada operación' },
  { label:'Disciplina Documental',   val:'100%',    desc:'Cada hallazgo y optimización de código queda registrado' },
];

const researchAreas = [
  { title:'Order Flow Research',    body:'Análisis de delta acumulado, absorción institucional y footprint de velas a nivel de tick.' },
  { title:'Algoritmos ML / AI',     body:'XGBoost, redes neuronales recurrentes y modelos de ensemble para clasificación de régimen de mercado.' },
  { title:'Optimización Hardware',  body:'Configuración de infraestructura de bajo nivel de latencia: selección de broker, VPS colocados y data feeds premium.' },
  { title:'Risk & Portfolio Mgmt.', body:'Dimensionamiento de posición adaptativo, correlación entre sistemas y gestión de drawdown en tiempo real.' },
  { title:'Backtesting Riguroso',   body:'Metodología propia de multi-pass OOS y pruebas de robustez estadística para evitar el curve-fitting.' },
  { title:'Psicología Cuantitativa',body:'Eliminación del factor humano como variable. El algoritmo no interpreta; ejecuta las instrucciones estadísticas al pie de la letra.' },
];
---

<section id="cerebro" aria-labelledby="cerebro-heading"
  style="position:relative;background:#0A0A0A;padding:7rem 0;overflow:hidden;border-top:1px solid rgba(0,255,102,0.07);">

  <SvgTextures variant="neural" />

  <!-- Ambient glow -->
  <div aria-hidden="true" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:70vw;height:70vw;background:radial-gradient(ellipse,rgba(0,255,102,0.03) 0%,transparent 60%);pointer-events:none;"></div>

  <div style="max-width:1400px;margin:0 auto;padding:0 2rem;position:relative;z-index:10;">

    <!-- Header -->
    <div class="reveal" style="margin-bottom:4.5rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
        <span style="display:inline-block;width:2rem;height:1px;background:#00FF66;"></span>
        <span style="font-family:'Inter',sans-serif;font-size:0.6375rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:#00FF66;">04 — El Cerebro Digital</span>
      </div>

      <div class="brain-header" style="display:grid;grid-template-columns:61.8fr 38.2fr;gap:4rem;align-items:end;">
        <div>
          <h2 id="cerebro-heading" style="font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(2rem,4.5vw,3.25rem);letter-spacing:-0.05em;color:#fff;line-height:1.05;margin:0 0 1.25rem;">
            Documentación<br />y
            <span class="quant-hook" style="font-size:clamp(2.2rem,5vw,3.5rem);">rigor científico.</span>
          </h2>
          <p style="font-family:'Inter',sans-serif;font-size:1rem;line-height:1.82;color:#D1D5DB;max-width:56ch;margin:0;">
            Cada hallazgo, backtest fallido y optimización de código se estructura en nuestro
            <span class="quant-hook" style="font-size:1rem;">Grafo de Conocimiento Semántico</span>.
            No operamos por sensaciones; operamos basándonos en un repositorio interconectado de investigación financiera en constante evolución. La disciplina institucional comienza en la documentación.
          </p>
        </div>
        <!-- Live indicator card -->
        <div style="background:#080808;border:1px solid rgba(0,255,102,0.15);border-radius:16px;padding:1.75rem;display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <span style="width:8px;height:8px;background:#00FF66;border-radius:50%;display:inline-block;animation:pulse-dot 2s ease-in-out infinite;"></span>
            <span style="font-family:'Inter',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00FF66;">Sistema Vivo</span>
          </div>
          <div style="font-family:'Courier New',monospace;font-size:0.75rem;color:#4B5563;line-height:1.7;">
            <div><span style="color:#00FF66;">▶</span> knowledge_graph.py --sync</div>
            <div style="padding-left:1rem;">nodes: <span style="color:#D1D5DB;">14.823</span></div>
            <div style="padding-left:1rem;">edges: <span style="color:#D1D5DB;">89.204</span></div>
            <div style="padding-left:1rem;">last_update: <span style="color:#00FF66;">live</span> <span class="cursor-blink" style="color:#00FF66;">█</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4 stat nodes -->
    <div class="brain-stats" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.5px;background:rgba(0,255,102,0.07);border-radius:16px;overflow:hidden;margin-bottom:4rem;">
      {nodes.map((n, i) => (
        <div
          class={`reveal reveal-delay-${i}`}
          style="background:#080808;padding:2rem 1.75rem;transition:transform 0.3s ease,background 0.3s ease,box-shadow 0.3s ease;cursor:default;"
          onmouseover="this.style.transform='translateY(-4px)';this.style.background='#0C0C0C';this.style.boxShadow='0 10px 32px rgba(0,255,102,0.08)'"
          onmouseout="this.style.transform='translateY(0)';this.style.background='#080808';this.style.boxShadow='none'"
        >
          <div style="font-family:'Inter',sans-serif;font-weight:900;font-size:2rem;color:#00FF66;letter-spacing:-0.04em;line-height:1;">{n.val}</div>
          <div style="font-family:'Inter',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#fff;margin-top:0.6rem;">{n.label}</div>
          <div style="font-family:'Inter',sans-serif;font-size:0.78rem;color:#6B7280;margin-top:0.5rem;line-height:1.55;">{n.desc}</div>
        </div>
      ))}
    </div>

    <!-- Research areas — 3×2 grid -->
    <div class="reveal reveal-delay-1" style="margin-bottom:1rem;">
      <div style="font-family:'Inter',sans-serif;font-size:0.6375rem;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;color:#4B5563;margin-bottom:2rem;">Áreas de Investigación Activa</div>
    </div>

    <div class="brain-research" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,0.04);border-radius:16px;overflow:hidden;">
      {researchAreas.map((r, i) => (
        <article
          class={`reveal reveal-delay-${i % 3}`}
          style="background:#080808;padding:2rem 1.75rem;border-radius:0;transition:transform 0.3s ease,background 0.3s ease,border-color 0.3s ease;cursor:default;position:relative;border-bottom:2px solid transparent;"
          onmouseover="this.style.transform='translateY(-3px)';this.style.background='#0D0D0D';this.style.borderBottomColor='rgba(0,255,102,0.4)'"
          onmouseout="this.style.transform='translateY(0)';this.style.background='#080808';this.style.borderBottomColor='transparent'"
        >
          <!-- Number badge -->
          <div style="font-family:'Inter',sans-serif;font-size:0.58rem;font-weight:700;letter-spacing:0.2em;color:rgba(0,255,102,0.35);margin-bottom:0.875rem;">{String(i+1).padStart(2,'0')}</div>
          <h3 style="font-family:'Inter',sans-serif;font-weight:800;font-size:1rem;color:#fff;letter-spacing:-0.02em;margin-bottom:0.625rem;line-height:1.3;">{r.title}</h3>
          <p style="font-family:'Inter',sans-serif;font-size:0.825rem;line-height:1.7;color:#6B7280;">{r.body}</p>
        </article>
      ))}
    </div>

    <!-- Knowledge graph visual mock -->
    <div class="reveal reveal-delay-2" style="margin-top:4rem;">
      <div style="background:#080808;border:1px solid rgba(0,255,102,0.12);border-radius:20px;padding:2.5rem;overflow:hidden;position:relative;">
        <div style="font-family:'Inter',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#4B5563;margin-bottom:1.5rem;">Knowledge Graph — Snapshot</div>

        <!-- SVG knowledge graph diagram -->
        <svg width="100%" height="220" viewBox="0 0 900 220" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Representación visual del grafo de conocimiento">
          <!-- Edges -->
          <g stroke="rgba(0,255,102,0.15)" stroke-width="1">
            <line x1="100" y1="110" x2="280" y2="55"/>
            <line x1="100" y1="110" x2="280" y2="110"/>
            <line x1="100" y1="110" x2="280" y2="165"/>
            <line x1="280" y1="55"  x2="460" y2="40"/>
            <line x1="280" y1="55"  x2="460" y2="90"/>
            <line x1="280" y1="110" x2="460" y2="90"/>
            <line x1="280" y1="110" x2="460" y2="140"/>
            <line x1="280" y1="165" x2="460" y2="140"/>
            <line x1="280" y1="165" x2="460" y2="185"/>
            <line x1="460" y1="40"  x2="640" y2="55"/>
            <line x1="460" y1="90"  x2="640" y2="55"/>
            <line x1="460" y1="90"  x2="640" y2="110"/>
            <line x1="460" y1="140" x2="640" y2="110"/>
            <line x1="460" y1="140" x2="640" y2="165"/>
            <line x1="460" y1="185" x2="640" y2="165"/>
            <line x1="640" y1="55"  x2="800" y2="110"/>
            <line x1="640" y1="110" x2="800" y2="110"/>
            <line x1="640" y1="165" x2="800" y2="110"/>
          </g>
          <!-- Layer labels -->
          <text x="100" y="130" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="rgba(0,255,102,0.5)" letter-spacing="1">INPUT</text>
          <text x="280" y="195" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="rgba(0,255,102,0.4)" letter-spacing="1">RESEARCH</text>
          <text x="460" y="210" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="rgba(0,255,102,0.4)" letter-spacing="1">PROCESS</text>
          <text x="640" y="195" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="rgba(0,255,102,0.4)" letter-spacing="1">VALIDATE</text>
          <text x="800" y="130" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="rgba(0,255,102,0.5)" letter-spacing="1">DEPLOY</text>
          <!-- Nodes — Layer 1 -->
          <circle cx="100" cy="110" r="10" fill="rgba(0,255,102,0.15)" stroke="#00FF66" stroke-width="1.5"/>
          <!-- Layer 2 -->
          <circle cx="280" cy="55"  r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <circle cx="280" cy="110" r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <circle cx="280" cy="165" r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <!-- Layer 3 -->
          <circle cx="460" cy="40"  r="6" fill="rgba(0,255,102,0.08)" stroke="rgba(0,255,102,0.4)" stroke-width="1"/>
          <circle cx="460" cy="90"  r="6" fill="rgba(0,255,102,0.08)" stroke="rgba(0,255,102,0.4)" stroke-width="1"/>
          <circle cx="460" cy="140" r="6" fill="rgba(0,255,102,0.08)" stroke="rgba(0,255,102,0.4)" stroke-width="1"/>
          <circle cx="460" cy="185" r="6" fill="rgba(0,255,102,0.08)" stroke="rgba(0,255,102,0.4)" stroke-width="1"/>
          <!-- Layer 4 -->
          <circle cx="640" cy="55"  r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <circle cx="640" cy="110" r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <circle cx="640" cy="165" r="7" fill="rgba(0,255,102,0.1)" stroke="rgba(0,255,102,0.5)" stroke-width="1"/>
          <!-- Output -->
          <circle cx="800" cy="110" r="11" fill="rgba(0,255,102,0.2)" stroke="#00FF66" stroke-width="1.5"/>
          <circle cx="800" cy="110" r="18" fill="none" stroke="rgba(0,255,102,0.12)" stroke-width="1" stroke-dasharray="4 4"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes pulse-dot { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:1;transform:scale(1.3)} }
  @media (max-width:1000px) { .brain-stats { grid-template-columns:repeat(2,1fr) !important; } }
  @media (max-width:900px)  {
    .brain-header   { grid-template-columns:1fr !important; gap:1.5rem !important; }
    .brain-research { grid-template-columns:repeat(2,1fr) !important; }
  }
  @media (max-width:600px)  {
    .brain-stats    { grid-template-columns:1fr !important; }
    .brain-research { grid-template-columns:1fr !important; }
  }
</style>
