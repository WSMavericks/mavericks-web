/* ════════════════════════════════════════════════════════════
   SLIDE LAYOUT — scoped styles for scroll-jacking sub-slides.
   Class-based BEM-like naming to avoid global leakage.
════════════════════════════════════════════════════════════ */

/* Inner wrapper: centers content, respects nav height */
.slide-inner {
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  padding: 5rem 2rem 2rem;
  height: 100%;
  display: flex;
  align-items: center;
}
.slide-inner--center {
  justify-content: center;
  flex-direction: column;
  align-items: center;
  gap: 2rem;
  text-align: center;
}

/* Base slide grid — overridden per-section */
.slide-grid {
  display: grid;
  align-items: center;
  width: 100%;
  gap: 4rem;
}
.hero-grid     { grid-template-columns: 38.2fr 61.8fr; }
.problem-grid  { grid-template-columns: 61.8fr 38.2fr; }
.solution-grid { grid-template-columns: 38.2fr 61.8fr; }
.lab-grid      { grid-template-columns: 61.8fr 38.2fr; }

/* ── Typography ── */
.eyebrow {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.25rem;
}
.eyebrow-line {
  width: 2rem;
  height: 1px;
  background: #00FF66;
  display: inline-block;
  flex-shrink: 0;
}
.eyebrow span:last-child {
  font-family: 'Inter', sans-serif;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
