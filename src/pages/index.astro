---
// index.astro — Scroll-Jacking architecture with intra-section sub-slides.
// 4 section-scroll containers (Hero, Problem, Solution, Lab).
// Each has a sticky viewport + N sub-slides cross-faded by scroll progress.
// Scroll data is written to window.__wsmScroll for the SceneManager (BaseLayout).

import BaseLayout   from '../layouts/BaseLayout.astro';
import Nav          from '../components/Nav.astro';
import Solution     from '../components/Solution.astro';
import Brain        from '../components/Brain.astro';
import LeadCapture  from '../components/LeadCapture.astro';
import Footer       from '../components/Footer.astro';
