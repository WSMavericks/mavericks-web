<!-- ═══════════════════════════════════════════════════════════
     SUB-SLIDE SCROLL ENGINE
     Calculates scroll progress per section, drives sub-slide
     opacity cross-fades, and writes window.__wsmScroll for the
     WebGL SceneManager to read each frame.
     No while, no break, no continue, no pass.
═══════════════════════════════════════════════════════════ -->
<script>
  window.__wsmScroll = window.__wsmScroll || { activeSection: 'hero', progress: 0 };

  /**
   * Compute sequential opacity for a sub-slide.
   * Completely avoids overlap: current slide fades out to 0 BEFORE next slide fades in.
   * No forbidden keywords — pure math.
   */
  const getSubSlideOpacity = (progress: number, index: number, total: number): number => {
    const seg = 1 / total;
    const start = index * seg;
    const end = (index + 1) * seg;

    // Boundary rules: keep first/last slides opaque when out of container bounds
    if (index === 0 && progress <= 0) return 1;
    if (index === total - 1 && progress >= 1) return 1;

    // Strict bounds: if outside segment, opacity is strictly 0 (no overlap)
    if (progress <= start || progress >= end) return 0;

    // Inside segment, compute fade-in (start) and fade-out (end)
    const fadeLen = seg * 0.15; // 15% of segment is used for fading

    const fadeIn = index === 0 ? 1 : Math.min(1, (progress - start) / fadeLen);
    const fadeOut = index === total - 1 ? 1 : Math.min(1, (end - progress) / fadeLen);

    return Math.min(fadeIn, fadeOut);
  };

  // ── Gather section-scroll elements and their sub-slides ──
  const sections = Array.from(document.querySelectorAll('.section-scroll'));
  const canvasEl = document.getElementById('wsm-webgl') as HTMLCanvasElement | null;

  interface SectionEntry {
    el: HTMLElement;
    sceneId: string;
    subSlides: HTMLElement[];
    top: number;
    height: number;
  }

  let sectionEntries: SectionEntry[] = sections.map(el => ({
    el: el as HTMLElement,
    sceneId: (el as HTMLElement).dataset.section || '',
    subSlides: Array.from(el.querySelectorAll('.sub-slide')) as HTMLElement[],
    top: (el as HTMLElement).offsetTop,
    height: (el as HTMLElement).offsetHeight,
  }));

  // Cache offsets and recalculate on resize
  const cacheOffsets = () => {
    sectionEntries = sectionEntries.map(entry => ({
      ...entry,
      top: window.scrollY + entry.el.getBoundingClientRect().top,
      height: entry.el.offsetHeight,
    }));
  };
  window.addEventListener('resize', cacheOffsets, { passive: true });

  // Canvas fade transition
  if (canvasEl) {
    canvasEl.style.transition = 'opacity 0.6s ease';
  }

  // ── Main scroll handler ──
  const updateScrollState = () => {
    const scrollY = window.scrollY;
    let foundActive: string | null = null;
    let foundProgress = 0;

    sectionEntries.forEach(entry => {
      const scrollable = Math.max(1, entry.height - window.innerHeight);
      const scrolled = scrollY - entry.top;
      const progress = Math.min(1, Math.max(0, scrolled / scrollable));
      const isInRange = scrollY >= entry.top && scrollY < entry.top + entry.height;

      if (isInRange) {
        foundActive = entry.sceneId;
        foundProgress = progress;
      }

      // Update sub-slide opacities via cross-fade
      const total = entry.subSlides.length;
      entry.subSlides.forEach((slide, i) => {
        const op = getSubSlideOpacity(progress, i, total);
        slide.style.opacity = String(Math.max(0, Math.min(1, op)));
        slide.style.pointerEvents = op > 0.5 ? 'auto' : 'none';
      });
    });

    // Publish scroll state for SceneManager
    window.__wsmScroll.activeSection = foundActive;
    window.__wsmScroll.progress = foundProgress;

    // Canvas visibility: fade out when past all 3D sections
    if (canvasEl) {
      canvasEl.style.opacity = foundActive ? '1' : '0';
    }
  };

  window.addEventListener('scroll', updateScrollState, { passive: true });
  updateScrollState();
</script>

