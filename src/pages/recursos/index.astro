---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// Fetch and sort the collection functionally without break/continue
const allRecursos = await getCollection('recursos');
const sortedRecursos = allRecursos.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout 
  title="Wall Street Mavericks | Laboratorio de Recursos" 
  description="Biblioteca documental técnica, backtests y análisis de microestructura."
  show3D={false}
>
  <Nav />

  <main class="resources-container">
    <header class="resources-header">
      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        <span>Knowledge Graph</span>
      </div>
      <h1 class="display-heading">
        Laboratorio<br/>
        <span class="quant-hook">Quant.</span>
      </h1>
      <p class="body-copy">
        Repositorio técnico de estrategias, análisis de flujos y pruebas Out-of-Sample. La transparencia documental es la base de nuestra infraestructura.
      </p>
    </header>

    <div class="resources-grid">
      {sortedRecursos.map((recurso) => (
        <a href={`/recursos/${recurso.slug}`} class="resource-card">
          <div class="card-meta">
            <span class="card-category">{recurso.data.category}</span>
            <span class="card-date">
              {recurso.data.pubDate.toLocaleDateString('es-ES', { 
                year: 'numeric', month: 'short', day: 'numeric' 
              })}
            </span>
          </div>
          <h2 class="card-title">{recurso.data.title}</h2>
          <p class="card-desc">{recurso.data.description}</p>
          
          <div class="card-footer">
            {recurso.data.oosValidated ? (
              <span class="badge badge-success">
                <span class="badge-dot"></span>OOS Validated
              </span>
            ) : (
              <span class="badge badge-pending">
                <span class="badge-dot"></span>In Research
              </span>
            )}
            <span class="read-more">Leer artículo →</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Base Container */
  .resources-container {
    padding: 120px 2rem 6rem;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 80vh;
  }

  /* Header */
  .resources-header {
    margin-bottom: 4rem;
    max-width: 60ch;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .eyebrow-line {
    width: 2rem;
    height: 1px;
    background: #00FF66;
    display: inline-block;
  }
  .eyebrow span:last-child {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #00FF66;
  }
  .display-heading {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: #fff;
    margin: 0 0 1.5rem 0;
  }
  .quant-hook {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    color: #00FF66;
  }
  .body-copy {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.8;
    color: #9CA3AF;
  }

  /* Grid Asimétrico */
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
  /* Hacemos que el primer elemento sea más grande para romper la simetría si hay espacio */
  @media (min-width: 1024px) {
    .resource-card:first-child {
      grid-column: span 2;
    }
  }

  /* Card */
  .resource-card {
    display: flex;
    flex-direction: column;
    background: rgba(18, 18, 18, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .resource-card:hover {
    background: rgba(18, 18, 18, 0.8);
    border-color: rgba(0, 255, 102, 0.25);
    border-radius: 20px; /* Borde sutilmente más redondeado en hover como se requirió */
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0, 255, 102, 0.05);
  }

  /* Metadatos */
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    font-family: 'Inter', sans-serif;
  }
  .card-category {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #00FF66;
    background: rgba(0, 255, 102, 0.08);
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
  }
  .card-date {
    font-size: 0.75rem;
    color: #6B7280;
  }

  /* Contenido Card */
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #E5E7EB;
    margin: 0 0 1rem 0;
    line-height: 1.3;
    transition: color 0.3s ease;
  }
  .resource-card:hover .card-title {
    color: #00FF66;
  }
  .card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #9CA3AF;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  /* Footer Card */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 1.25rem;
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
  }
  .badge-success { color: #D1D5DB; }
  .badge-success .badge-dot { background: #00FF66; }
  .badge-pending { color: #6B7280; }
  .badge-pending .badge-dot { background: #F59E0B; }
  
  .read-more {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: #6B7280;
    transition: color 0.3s ease;
  }
  .resource-card:hover .read-more {
    color: #fff;
  }
</style>
